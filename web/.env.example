# RIO web — environment template. Copy to .env.local (git-ignored) and fill in.
#
# Supabase → Project Settings → API. The anon key is designed to be public;
# all data access is enforced by Row Level Security in Postgres.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of this app, used in auth email links and the OAuth callback.
# Must also be listed in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only / operator tooling (never prefix with NEXT_PUBLIC_) ───────
# Service-role key BYPASSES RLS. The running app does not use it; only the
# demo seed script (npm run seed:demo) does. Leave empty in production.
SUPABASE_SERVICE_ROLE_KEY=

# Demo seeding guard: the seed script refuses to run unless this is "true".
RIO_DEMO_SEED=false
# Password given to every seeded demo account (min 10 chars). Required to seed.
RIO_DEMO_PASSWORD=

# Optional: run the live integration tests (tests/integration) against a
# DISPOSABLE Supabase project that has the migrations applied and is seeded.
# RIO_TEST_SUPABASE_URL=
# RIO_TEST_SUPABASE_ANON_KEY=
# RIO_TEST_PASSWORD=
